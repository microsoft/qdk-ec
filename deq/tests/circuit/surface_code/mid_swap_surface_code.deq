<%
# ---------------------------------------------------------------------------
# Mid-SWAP rotated surface-code memory experiment (Z basis).
#
# This single template renders two interchangeable layouts (Mako ``layout``):
#   * ``monolithic`` (default): the whole d-round cycle is unrolled into ONE
#     gadget with manual detectors, so the entire loss model is visible in a
#     single annotation; decode it with the monolithic coordinator.
#   * ``windowed``: each round is its own port-factored gadget (PrepareZ ->
#     MidSwapSyndrome*(rounds-1) -> MeasureZ) with auto-inferred detectors, so
#     the window coordinator can slide across the rounds.
# Both layouts share the geometry, stabiliser bookkeeping, and the
# ``mid_swap_round()`` syndrome-extraction body defined below.
#
# Adapted from tests/circuit/surface_code/surface_code.deq (geometry) and the
# "Mid-SWAP" syndrome-extraction circuit of the Pauli-envelope loss-decoding
# paper (Sec. "Loss-Replenishing Syndrome Extraction for Surface Codes").
#
# The Mid-SWAP circuit is a standard rotated-surface-code syndrome extraction
# with one modification: an atom-shuttle SWAP is inserted immediately after the
# FIRST CNOT of each round, swapping every ancilla with the data neighbour it
# just interacted with.  Ideally CNOT1 + SWAP is a no-op (after CNOT1 the two
# qubits carry the same value), so the measured syndrome is unchanged; the SWAP
# only changes how an atom loss propagates, which is exactly the point.
#
# Mako parameters
#   d        (int)   : code distance (odd, >= 3)
#   rounds   (int)   : number of syndrome-extraction rounds (default d)
#   p_loss   (float) : per-round atom-loss probability on every live qubit
#   p        (float) : per-round depolarizing Pauli-noise rate (0 disables it,
#                      which is the default so annotation stays noise-free)
#   layout   (str)   : 'monolithic' (default; single unrolled gadget + manual
#                      detectors) or 'windowed' (port-factored per-round gadgets
#                      with auto-inferred detectors)
# ---------------------------------------------------------------------------
d = int(context.get("d", 3))
assert d >= 3 and d % 2 == 1, "Expected 'd' to be an odd integer >= 3"
rounds = int(context.get("rounds", d))
p_loss = float(context.get("p_loss", 0.1))
p = float(context.get("p", 0.0))
layout = str(context.get("layout", "monolithic"))
assert layout in ("monolithic", "windowed"), (
    "Expected 'layout' to be 'monolithic' or 'windowed'"
)

# --- data-qubit coordinates (row i, col j), indices 0 .. d*d-1 ---------------
coordinates: list[tuple[float, float]] = []
for i in range(d):
    for j in range(d):
        coordinates.append((i, j))
n = d * d


def stabilizer_type(i: float, j: float) -> str | None:
    if i == -0.5:
        return "z" if j % 2 == 1.5 and j > 0 and j < d - 1 else None
    if i == d - 0.5:
        return "z" if j % 2 == 0.5 and j > 0 and j < d - 1 else None
    if j == -0.5:
        return "x" if i % 2 == 0.5 and i > 0 and i < d - 1 else None
    if j == d - 0.5:
        return "x" if i % 2 == 1.5 and i > 0 and i < d - 1 else None
    if i % 1 == 0.5 and j % 1 == 0.5 and i > 0 and i < d and j > 0 and j < d:
        return "x" if (i + j) % 2 == 0 else "z"
    return None


# --- ancilla-qubit coordinates, indices n .. 2*n-2 ---------------------------
for i in range(d + 1):
    for j in range(d + 1):
        st = stabilizer_type(i - 0.5, j - 0.5)
        if st is not None:
            coordinates.append((i - 0.5, j - 0.5))
assert len(coordinates) == 2 * n - 1, f"expected {2 * n - 1} qubits"
index_of: dict[tuple[float, float], int] = {c: k for k, c in enumerate(coordinates)}

# --- stabilizer generators (code definition) --------------------------------
stabilizers: list[str] = []
for i in range(d + 1):
    for j in range(d + 1):
        st = stabilizer_type(i - 0.5, j - 0.5)
        if st is None:
            continue
        members: list[str] = []
        for di in (-0.5, 0.5):
            for dj in (-0.5, 0.5):
                qi, qj = i - 0.5 + di, j - 0.5 + dj
                if 0 <= qi < d and 0 <= qj < d:
                    members.append(f"{st.upper()}{index_of[(qi, qj)]}")
        stabilizers.append("*".join(members))
assert len(stabilizers) == n - 1, f"expected {n - 1} stabilizers"

# --- ancilla bookkeeping -----------------------------------------------------
anc_indices = [k for k in range(n, 2 * n - 1)]
z_anc = [k for k in anc_indices if stabilizer_type(*coordinates[k]) == "z"]
x_anc = [k for k in anc_indices if stabilizer_type(*coordinates[k]) == "x"]


# Fixed corner-per-layer schedule (paper): X ancillas extract in the Z-shaped
# order (TL, TR, BL, BR); Z ancillas in the N-shaped order (TL, BL, TR, BR).
# Both start on the top-left data neighbour, which is the atom-shuttle partner.
# The corner for each layer is FIXED: a boundary ancilla that lacks that corner
# simply has no CNOT in that layer (rather than compacting its remaining
# neighbours into earlier layers, which would break the detector schedule).
TL, TR, BL, BR = (-0.5, -0.5), (-0.5, 0.5), (0.5, -0.5), (0.5, 0.5)
x_order = [TL, TR, BL, BR]
z_order = [TL, BL, TR, BR]


def neighbour(k: int, corner: tuple[float, float]) -> int | None:
    """Data index at ``corner`` of ancilla ``k``, or None at the boundary."""
    ai, aj = coordinates[k]
    return index_of.get((ai + corner[0], aj + corner[1]))


def cnot_pairs(layer: int) -> list[tuple[int, int]]:
    """(control, target) pairs for CNOT layer ``layer`` (0-based)."""
    pairs: list[tuple[int, int]] = []
    for k in anc_indices:
        if stabilizer_type(*coordinates[k]) == "z":
            data = neighbour(k, z_order[layer])
            if data is not None:
                pairs.append((data, k))  # data controls, ancilla (Z) is target
        else:
            data = neighbour(k, x_order[layer])
            if data is not None:
                pairs.append((k, data))  # ancilla (X) controls, data is target
    return pairs


def swap_pairs() -> list[tuple[int, int]]:
    """(ancilla, top-left neighbour) atom-shuttle SWAP pairs (after layer 0)."""
    pairs: list[tuple[int, int]] = []
    for k in anc_indices:
        data = neighbour(k, TL)
        if data is not None:
            pairs.append((k, data))
    return pairs


def fmt_pairs(pairs: list[tuple[int, int]]) -> str:
    return " ".join(f"{a} {b}" for a, b in pairs)


# logical-Z representative: a column of data qubits {0, d, 2d, ...}
logical_z_data = [d * i for i in range(d)]

# --- manual-detector bookkeeping --------------------------------------------
# Each round measures the Z ancillas (MZ) then the X ancillas (MX); a final
# transversal MZ reads out the data.  rec_* return the rec[-k] reference of a
# measurement counting back from the end of the record.
num_z = len(z_anc)
num_x = len(x_anc)
per_round = num_z + num_x
total_meas = rounds * per_round + n
z_anc_coords = [coordinates[k] for k in z_anc]


def rec_z(r: int, k: int) -> str:
    return f"rec[-{total_meas - (r * per_round + k)}]"


def rec_x(r: int, k: int) -> str:
    return f"rec[-{total_meas - (r * per_round + num_z + k)}]"


def rec_data(q: int) -> str:
    return f"rec[-{total_meas - (rounds * per_round + q)}]"


def data_support(c: tuple[float, float]) -> list[int]:
    """Data-qubit indices supporting the stabiliser at ancilla coordinate ``c``."""
    ci, cj = c
    support: list[int] = []
    for di in (-0.5, 0.5):
        for dj in (-0.5, 0.5):
            idx = index_of.get((ci + di, cj + dj))
            if idx is not None and idx < n:
                support.append(idx)
    return support
%>\
CODE SurfaceCode [[${n},1,${d}]] {
    LOGICAL ${"*".join(f"X{i}" for i in range(d))} ${"*".join(f"Z{d*i}" for i in range(d))}
    STABILIZER ${" ".join(stabilizers)}
}

<%def name="mid_swap_round()">\
    RZ ${" ".join(str(k) for k in z_anc)}
    RX ${" ".join(str(k) for k in x_anc)}
    LOSS_ERROR(${p_loss}) ${" ".join(str(k) for k in range(2 * n - 1))}
% if p > 0:
    DEPOLARIZE1(${p}) ${" ".join(str(k) for k in range(2 * n - 1))}
% endif
    CX ${fmt_pairs(cnot_pairs(0))}
    SWAP ${fmt_pairs(swap_pairs())}
    CX ${fmt_pairs(cnot_pairs(1))}
    CX ${fmt_pairs(cnot_pairs(2))}
    CX ${fmt_pairs(cnot_pairs(3))}
% if p > 0:
    X_ERROR(${p}) ${" ".join(str(k) for k in z_anc)}
    Z_ERROR(${p}) ${" ".join(str(k) for k in x_anc)}
% endif
    MZ ${" ".join(str(k) for k in z_anc)}
    MX ${" ".join(str(k) for k in x_anc)}
</%def>\
% if layout == "monolithic":
# Single-gadget layout: the unrolled gadget already contains the full d-round
# mid-SWAP cycle, its manual detectors, and the logical-Z readout, so the program
# just places it once. Decode with the monolithic coordinator, e.g.
#   deq simulate ler mid_swap_surface_code.deq --program MidSwapMemory \
#       --mako d=3 --skip-mako-warning --simulator qdk --coordinator monolithic
@CHECKS("manual")
GADGET MidSwapMemoryZ {
    # Prepare logical |0> (product state is a +1 eigenstate of every Z stabiliser).
    RZ ${" ".join(str(q) for q in range(n))}

% for r in range(rounds):
    # ---- Mid-SWAP syndrome-extraction round ${r} ----
    ${mid_swap_round()}
% endfor

    # Final data readout in the Z basis.
    MZ ${" ".join(str(q) for q in range(n))}
    READOUT ${" ".join(f"rec[-{n - q}]" for q in logical_z_data)}

    # Detectors compare each stabilizer between consecutive rounds. In the first
    # round only the Z stabilizers are deterministic (data reset to |0>); in the
    # final round only the Z stabilizers are recovered, from the Z-basis data
    # measurement. The X stabilizers are compared only across the interior rounds.
% for k in range(num_z):
    CHECK ${rec_z(0, k)}
% endfor
% for r in range(1, rounds):
% for k in range(num_z):
    CHECK ${rec_z(r, k)} ${rec_z(r - 1, k)}
% endfor
% for k in range(num_x):
    CHECK ${rec_x(r, k)} ${rec_x(r - 1, k)}
% endfor
% endfor
% for k in range(num_z):
    CHECK ${rec_z(rounds - 1, k)} ${" ".join(rec_data(q) for q in data_support(z_anc_coords[k]))}
% endfor
}

PROGRAM MidSwapMemory {
    MidSwapMemoryZ
    ASSERT_EQ rec[-1] 0
}
% else:
# Port-factored layout: each syndrome-extraction round is its own gadget with
# SurfaceCode INPUT/OUTPUT ports on the data qubits (0..n-1). Because CNOT layer
# 0 + SWAP is a value-level no-op (after CNOT0 an ancilla and its top-left data
# neighbour carry the same value, so swapping them leaves the values unchanged),
# the data-qubit *values* stay on positions 0..n-1 every round; only the physical
# atoms shuttle, which the loss model tracks via its cross-gadget
# child_output_qubits/input_losses links. Detectors are inferred automatically
# across the port boundaries (no @CHECKS("manual")), which is what lets the window
# coordinator slide across the rounds, e.g.
#   deq simulate ler mid_swap_surface_code.deq --program MidSwapMemory \
#       --mako d=3 layout=windowed --skip-mako-warning --simulator qdk \
#       --coordinator window --coordinator-config '{"buffer_radius": 2}'
GADGET PrepareZ {
    # Prepare logical |0> (a +1 eigenstate of every Z stabiliser) then extract
    # the first round of syndromes.
    RZ ${" ".join(str(q) for q in range(n))}
    ${mid_swap_round()}
    OUTPUT SurfaceCode ${" ".join(str(q) for q in range(n))}
}

GADGET MidSwapSyndrome {
    INPUT SurfaceCode ${" ".join(str(q) for q in range(n))}
    ${mid_swap_round()}
    OUTPUT SurfaceCode ${" ".join(str(q) for q in range(n))}
}

GADGET MeasureZ {
    INPUT SurfaceCode ${" ".join(str(q) for q in range(n))}
    MZ ${" ".join(str(q) for q in range(n))}
    READOUT ${" ".join(f"rec[-{n - q}]" for q in logical_z_data)}
}

PROGRAM MidSwapMemory {
    PrepareZ 0
    REPEAT ${rounds - 1} {
        MidSwapSyndrome 0
    }
    MeasureZ 0
    ASSERT_EQ rec[-1] 0
}
% endif
